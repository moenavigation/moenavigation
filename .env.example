# Required site origin. Use the verified HTTPS URL before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Enable only on the approved production domain after factual/content review.
# Preview deployments and local development remain noindex regardless.
SITE_INDEXING_ENABLED=false
SITE_CONTENT_APPROVED=false

# Enquiry notifications: add these server-side when Resend is ready.
# Keep blank until configured. Never use NEXT_PUBLIC_ for these values.
# Verify the sender's domain in Resend; use plain email addresses below.
# The visitor's email is Reply-To, never the sender or notification recipient.
# Enquiries keep saving in MongoDB while these are missing or email fails.
# Validate configuration without sending: npm run email:check
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
# Optional initial recipient until a list is saved under CMS Enquiries.
ENQUIRY_EMAIL_TO=

# Server-side MongoDB connection. Use a dedicated database for this site.
MONGODB_URI=
MONGODB_DB_NAME=

# Server-side Cloudinary credentials. Never prefix the secret with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional managed asset folder; defaults to moe-navigation.
# CLOUDINARY_FOLDER=moe-navigation

# Optional Vercel usage reporting for accounts with Billing Charges API access.
# The usage page also supports readings copied from the provider dashboard.
# Keep these credentials server-side; use a token with the least required access.
VERCEL_USAGE_TOKEN=
VERCEL_USAGE_TEAM_ID=

# Optional: replace the default OpenStreetMap tile source with a provider that
# supports your expected traffic. Follow that provider's attribution terms.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=Your tile provider
